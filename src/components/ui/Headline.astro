---
import type { Headline as Props } from '~/types';
import { twMerge } from 'tailwind-merge';

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline,
  classes = {},
} = Astro.props;

const {
  container: containerClass = 'max-w-3xl',
  title: titleClass = 'text-[clamp(2.25rem,3.4vw,3.25rem)]',
  subtitle: subtitleClass = 'text-xl',
} = classes;
---

{
  (title || subtitle || tagline) && (
    <div class={twMerge('mb-8 md:mx-auto md:mb-12 text-center', containerClass)}>
      {tagline && (
        <p class="text-base text-green-700 dark:text-green-300 font-bold tracking-wide uppercase" set:html={tagline} />
      )}
      {title && <h2 class={twMerge('primary-heading text-heading', titleClass)} set:html={title} />}

      {subtitle && <p class={twMerge('text-muted', subtitleClass)} set:html={subtitle} />}
    </div>
  )
}
