---
import '@fontsource-variable/newsreader';
// Self-hosted Fraunces for headings. `full` carries every axis — wght
// 100–900, opsz 9–144, plus the SOFT and WONK custom axes — which the
// Google Fonts build does not expose. See --aw-font-heading below and
// `.primary-heading` in tailwind.css for the axis values in use.
import '@fontsource-variable/fraunces/full.css';
import '@fontsource-variable/fraunces/full-italic.css';

// 'DM Sans'
// Nunito
// Dosis
// Outfit
// Roboto
// Literata
// 'IBM Plex Sans'
// Karla
// Poppins
// 'Fira Sans'
// 'Libre Franklin'
// Inconsolata
// Raleway
// Oswald
// 'Space Grotesk'
// Urbanist
---

<style is:inline>
  /* Palette per the feldklang design system (Mentora reference):
     warm "paper" tones, near-black "ink", one terracotta accent. No pure
     white or pure black anywhere. AstroWind's --aw-* names are kept since
     the Tailwind config and components already consume them. */
  :root {
    --aw-font-body: 'Newsreader Variable';
    --aw-font-heading: 'Fraunces Variable';
    /* UI chrome — nav links, buttons. See --aw-font-ui usage in tailwind.config.js. */
    --aw-font-ui: 'Spline Sans Mono';

    /* Extended palette (design system §02) */
    --aw-color-paper: #f7f2e8;
    --aw-color-paper-2: #efe7d9;
    --aw-color-paper-3: #e6dccb;
    --aw-color-ink: #17120d;
    --aw-color-ink-deep: #0d0906;
    --aw-color-ink-soft: #463d33;
    --aw-color-muted: #67594a;
    --aw-color-clay: #b86b42;
    --aw-color-olive: #515943;
    --aw-color-terracotta: #a84225;
    --aw-color-terracotta-deep: #7f2e1a;
    --aw-line: color-mix(in srgb, var(--aw-color-ink) 14%, transparent);
    --aw-line-strong: color-mix(in srgb, var(--aw-color-ink) 28%, transparent);
    --aw-shadow-soft: 0 32px 80px -54px rgb(23 18 13 / 0.48);

    /* Terracotta — the single accent: CTAs, links, emphasis.
       `secondary` is the deep step for hover/active. */
    --aw-color-primary: var(--aw-color-terracotta);
    --aw-color-secondary: var(--aw-color-terracotta-deep);
    --aw-color-accent: var(--aw-color-terracotta);

    --aw-color-text-heading: var(--aw-color-ink);
    --aw-color-text-default: var(--aw-color-ink-soft);
    --aw-color-text-muted: var(--aw-color-muted);
    --aw-color-text-page: var(--aw-color-ink);
    --aw-color-bg-page: var(--aw-color-paper);
    --aw-color-bg-page-secondary: var(--aw-color-paper-2);
    --aw-color-bg-page-dark: var(--aw-color-ink);

    ::selection {
      background-color: var(--aw-color-ink);
      color: var(--aw-color-paper);
    }
  }

  /* Dark surface (design system §03 — footer/inverted blocks): ink ground,
     paper text, accent swaps to the lighter clay. */
  .dark {
    --aw-font-body: 'Newsreader Variable';
    --aw-font-heading: 'Fraunces Variable';
    --aw-font-ui: 'Spline Sans Mono';

    --aw-color-primary: var(--aw-color-clay);
    --aw-color-secondary: #9c5535;
    --aw-color-accent: var(--aw-color-clay);

    --aw-color-text-heading: var(--aw-color-paper);
    --aw-color-text-default: var(--aw-color-paper-2);
    --aw-color-text-muted: rgb(247 242 232 / 68%);
    --aw-color-text-page: var(--aw-color-paper);
    --aw-color-bg-page: var(--aw-color-ink);
    --aw-color-bg-page-dark: var(--aw-color-ink-deep);

    ::selection {
      background-color: var(--aw-color-paper);
      color: var(--aw-color-ink);
    }
  }

  /* Image overlay effects */
  .image-blur-diagonal {
    position: relative;
    overflow: hidden;
    border-radius: 0.5rem;
  }

  /* Opacity fade on the image itself */
  .image-blur-diagonal img {
    mask-image:
      linear-gradient(
        135deg,
        transparent 0%,
        rgba(0, 0, 0, 0.15) 15%,
        rgba(0, 0, 0, 0.6) 30%,
        rgba(0, 0, 0, 1) 45%,
        rgba(0, 0, 0, 1) 55%,
        rgba(0, 0, 0, 0.6) 70%,
        rgba(0, 0, 0, 0.15) 85%,
        transparent 100%
      ),
      linear-gradient(
        315deg,
        transparent 0%,
        rgba(0, 0, 0, 0.15) 15%,
        rgba(0, 0, 0, 0.6) 30%,
        rgba(0, 0, 0, 1) 45%,
        rgba(0, 0, 0, 1) 55%,
        rgba(0, 0, 0, 0.6) 70%,
        rgba(0, 0, 0, 0.15) 85%,
        transparent 100%
      );
    -webkit-mask-image:
      linear-gradient(
        135deg,
        transparent 0%,
        rgba(0, 0, 0, 0.15) 15%,
        rgba(0, 0, 0, 0.6) 30%,
        rgba(0, 0, 0, 1) 45%,
        rgba(0, 0, 0, 1) 55%,
        rgba(0, 0, 0, 0.6) 70%,
        rgba(0, 0, 0, 0.15) 85%,
        transparent 100%
      ),
      linear-gradient(
        315deg,
        transparent 0%,
        rgba(0, 0, 0, 0.15) 15%,
        rgba(0, 0, 0, 0.6) 30%,
        rgba(0, 0, 0, 1) 45%,
        rgba(0, 0, 0, 1) 55%,
        rgba(0, 0, 0, 0.6) 70%,
        rgba(0, 0, 0, 0.15) 85%,
        transparent 100%
      );
    mask-composite: intersect;
    -webkit-mask-composite: source-in;
  }

  /* Top-left blur */
  .image-blur-diagonal::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.2) 0%, transparent 50%);
    backdrop-filter: blur(22px);
    -webkit-backdrop-filter: blur(22px);
    mask-image: linear-gradient(135deg, rgba(0, 0, 0, 1) 0%, rgba(0, 0, 0, 0.7) 30%, transparent 60%);
    -webkit-mask-image: linear-gradient(135deg, rgba(0, 0, 0, 1) 0%, rgba(0, 0, 0, 0.7) 30%, transparent 60%);
    z-index: 1;
    pointer-events: none;
    border-radius: 0.5rem;
  }

  .dark .image-blur-diagonal::before {
    background: linear-gradient(135deg, rgba(0, 0, 0, 0.2) 0%, transparent 50%);
  }

  /* Bottom-right blur */
  .image-blur-diagonal::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(315deg, rgba(255, 255, 255, 0.2) 0%, transparent 50%);
    backdrop-filter: blur(22px);
    -webkit-backdrop-filter: blur(22px);
    mask-image: linear-gradient(315deg, rgba(0, 0, 0, 1) 0%, rgba(0, 0, 0, 0.7) 30%, transparent 60%);
    -webkit-mask-image: linear-gradient(315deg, rgba(0, 0, 0, 1) 0%, rgba(0, 0, 0, 0.7) 30%, transparent 60%);
    z-index: 1;
    pointer-events: none;
    border-radius: 0.5rem;
  }

  .dark .image-blur-diagonal::after {
    background: linear-gradient(315deg, rgba(0, 0, 0, 0.2) 0%, transparent 50%);
  }

  /* Diagonal line overlay - top-right to bottom-left */
  .image-blur-diagonal-line {
    position: relative;
    overflow: hidden;
    border-radius: 0.5rem;
  }

  /* Inherit the blur diagonal effects + add transparent diagonal cut from top-left to bottom-right */
  .image-blur-diagonal-line img {
    mask-image:
      linear-gradient(
        45deg,
        rgba(0, 0, 0, 1) 0%,
        rgba(0, 0, 0, 1) calc(50% - 1px),
        transparent calc(50% - 1px),
        transparent calc(50% + 1px),
        rgba(0, 0, 0, 1) calc(50% + 1px),
        rgba(0, 0, 0, 1) 100%
      ),
      linear-gradient(
        135deg,
        transparent 0%,
        rgba(0, 0, 0, 0.15) 15%,
        rgba(0, 0, 0, 0.6) 30%,
        rgba(0, 0, 0, 1) 45%,
        rgba(0, 0, 0, 1) 55%,
        rgba(0, 0, 0, 0.6) 70%,
        rgba(0, 0, 0, 0.15) 85%,
        transparent 100%
      ),
      linear-gradient(
        315deg,
        transparent 0%,
        rgba(0, 0, 0, 0.15) 15%,
        rgba(0, 0, 0, 0.6) 30%,
        rgba(0, 0, 0, 1) 45%,
        rgba(0, 0, 0, 1) 55%,
        rgba(0, 0, 0, 0.6) 70%,
        rgba(0, 0, 0, 0.15) 85%,
        transparent 100%
      );
    -webkit-mask-image:
      linear-gradient(
        45deg,
        rgba(0, 0, 0, 1) 0%,
        rgba(0, 0, 0, 1) calc(50% - 1px),
        transparent calc(50% - 1px),
        transparent calc(50% + 1px),
        rgba(0, 0, 0, 1) calc(50% + 1px),
        rgba(0, 0, 0, 1) 100%
      ),
      linear-gradient(
        135deg,
        transparent 0%,
        rgba(0, 0, 0, 0.15) 15%,
        rgba(0, 0, 0, 0.6) 30%,
        rgba(0, 0, 0, 1) 45%,
        rgba(0, 0, 0, 1) 55%,
        rgba(0, 0, 0, 0.6) 70%,
        rgba(0, 0, 0, 0.15) 85%,
        transparent 100%
      ),
      linear-gradient(
        315deg,
        transparent 0%,
        rgba(0, 0, 0, 0.15) 15%,
        rgba(0, 0, 0, 0.6) 30%,
        rgba(0, 0, 0, 1) 45%,
        rgba(0, 0, 0, 1) 55%,
        rgba(0, 0, 0, 0.6) 70%,
        rgba(0, 0, 0, 0.15) 85%,
        transparent 100%
      );
    mask-composite: intersect;
    -webkit-mask-composite: source-in;
  }

  /* Top-left blur */
  .image-blur-diagonal-line::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.2) 0%, transparent 50%);
    backdrop-filter: blur(22px);
    -webkit-backdrop-filter: blur(22px);
    mask-image: linear-gradient(135deg, rgba(0, 0, 0, 1) 0%, rgba(0, 0, 0, 0.7) 30%, transparent 60%);
    -webkit-mask-image: linear-gradient(135deg, rgba(0, 0, 0, 1) 0%, rgba(0, 0, 0, 0.7) 30%, transparent 60%);
    z-index: 1;
    pointer-events: none;
    border-radius: 0.5rem;
  }

  .dark .image-blur-diagonal-line::before {
    background: linear-gradient(135deg, rgba(0, 0, 0, 0.2) 0%, transparent 50%);
  }

  /* Bottom-right blur */
  .image-blur-diagonal-line::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(315deg, rgba(255, 255, 255, 0.2) 0%, transparent 50%);
    backdrop-filter: blur(22px);
    -webkit-backdrop-filter: blur(22px);
    mask-image: linear-gradient(315deg, rgba(0, 0, 0, 1) 0%, rgba(0, 0, 0, 0.7) 30%, transparent 60%);
    -webkit-mask-image: linear-gradient(315deg, rgba(0, 0, 0, 1) 0%, rgba(0, 0, 0, 0.7) 30%, transparent 60%);
    z-index: 1;
    pointer-events: none;
    border-radius: 0.5rem;
  }

  .dark .image-blur-diagonal-line::after {
    background: linear-gradient(315deg, rgba(0, 0, 0, 0.2) 0%, transparent 50%);
  }
</style>
