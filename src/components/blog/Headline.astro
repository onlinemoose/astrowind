---
const { title = await Astro.slots.render('default'), subtitle = await Astro.slots.render('subtitle') } = Astro.props;
---

<header class="mb-8 md:mb-16 max-w-3xl">
  <h1 class="primary-heading primary-heading--hero text-[clamp(2.5rem,4.5vw,4rem)]" set:html={title} />
  {subtitle && <div class="mt-2 md:mt-3 text-xl text-muted" set:html={subtitle} />}
</header>
